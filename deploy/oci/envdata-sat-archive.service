[Unit]
Description=Archive previous UTC day of satellite radiation CSV data
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/envdata-sat
EnvironmentFile=/etc/envdata-sat/archive.env
ExecStart=/usr/bin/bash /opt/envdata-sat/deploy/oci/run_daily.sh
TimeoutStartSec=30min
